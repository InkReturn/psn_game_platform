[Unit]
Description=LinkPlay private game platform and arcade worlds
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/linkplay/current
Environment=PORT=8080
Environment=BIND_HOST=127.0.0.1
Environment=NODE_ENV=production
ExecStart=/usr/bin/node integrations/start-arcade.cjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=12
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/linkplay
UMask=0027
MemoryMax=1200M
CPUQuota=200%
TasksMax=128
LimitNOFILE=8192
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
